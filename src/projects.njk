    <div class="screenshot-frame screenshot-frame--dark"><img src="{{ site.basePath }}/assets/skillforge-command-center.png" alt="SkillForge Academy application screenshot showing a certification study command center with course navigation, a practice recommendation, study progress, and subject coverage." width="2880" height="1800" loading="lazy"></div>
