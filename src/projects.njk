        <h2 id="skillforge-title"><a href="{{ project.url }}">{{ project.name }} <span aria-hidden="true">↗</span></a></h2>
        <p>{{ project.summary }}</p>
        <p class="availability-copy"><strong>Release boundary.</strong> {{ project.maturity }}</p>
        <div class="product-entry-links"><a href="{{ project.url }}">{{ project.action }} <span aria-hidden="true">↗</span></a><a href="{{ project.secondaryUrl }}">{{ project.secondaryAction }} <span aria-hidden="true">↗</span></a></div>
      </div>
    {% endif %}{% endfor %}
  </div>
</section>

<section class="availability-foot page-shell" aria-labelledby="availability-title">
  <div>
    <p class="eyebrow">Status guide</p>
    <h2 id="availability-title">Availability means what the source says.</h2>
  </div>
  <ul>
    <li><span class="status status--released">Released</span><span>A package or application is available through the linked release channel. The repository's current branch may be newer.</span></li>
    <li><span class="status status--preview">Preview</span><span>Source or early software is available to inspect; packaging, API, schema, or platform support can still change.</span></li>
    <li><span class="status status--private">Private development</span><span>Public overview material may exist, but there is no public build or release to install.</span></li>
    <li><span class="status status--related">Related work</span><span>Maintained outside the ForgeWire Labs organization with its own source and release channel.</span></li>
  </ul>
  <p class="source-note">Product links and maturity notes were checked against the linked public repositories and release pages. Preview and source-build status carries no production-support claim.</p>
</section>
