<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="color-scheme" content="light">
    <meta name="theme-color" content="#171d19">
    <title>{{ title }} | {{ site.name }}</title>
    <meta name="description" content="{{ description or site.description }}">
    <link rel="canonical" href="{{ site.url }}{{ site.basePath }}{{ page.url }}">
    {% if site.preview %}<meta name="robots" content="noindex, nofollow">{% endif %}
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="{{ site.name }}">
    <meta property="og:title" content="{{ title }} | {{ site.name }}">
    <meta property="og:description" content="{{ description or site.description }}">
    <meta property="og:url" content="{{ site.url }}{{ site.basePath }}{{ page.url }}">
    <meta property="og:image" content="{{ site.url }}{{ site.basePath }}{{ site.socialImage }}">
    <meta name="twitter:card" content="summary_large_image">
    <link rel="icon" href="{{ site.basePath }}/assets/favicon.svg" type="image/svg+xml">
    <link rel="stylesheet" href="{{ site.basePath }}/assets/site.css">
  </head>
  <body>
    {% if site.preview %}<div class="preview-banner" role="note">Development preview · Temporary public review copy</div>{% endif %}
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="header-inner">
        <a class="wordmark" href="{{ site.basePath }}/" aria-label="ForgeWire Labs home">
          <svg class="brand-symbol" viewBox="0 0 40 40" aria-hidden="true" focusable="false">
            <path d="M8 11h13v18H8M21 20h11M32 20v9M21 11h11" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square"/>
            <circle cx="8" cy="11" r="2.6"/><circle cx="8" cy="29" r="2.6"/><circle cx="32" cy="11" r="2.6"/><circle cx="32" cy="20" r="2.6"/><circle cx="32" cy="29" r="2.6"/>
          </svg>
          <span class="brand-copy"><strong>ForgeWire Labs</strong><small>Independent engineering</small></span>
        </a>
        <nav aria-label="Main navigation">
          <ul class="nav-list">
            <li><a href="{{ site.basePath }}/projects/"{% if page.url.startsWith('/projects') %} aria-current="page"{% endif %}>Projects</a></li>
            <li><a href="{{ site.basePath }}/engineering/"{% if page.url.startsWith('/engineering') %} aria-current="page"{% endif %}>Engineering</a></li>
            <li><a href="{{ site.basePath }}/about/"{% if page.url.startsWith('/about') %} aria-current="page"{% endif %}>About</a></li>
          </ul>
        </nav>
      </div>
    </header>
    <main id="main" tabindex="-1">
      {{ content | safe }}
    </main>
    <footer class="site-footer">
      <div class="footer-inner">
        <a class="footer-name" href="{{ site.basePath }}/">ForgeWire Labs</a>
        <p class="footer-summary">Independent engineering for distributed computing and intelligent systems.</p>
        <div class="footer-links">
          <a href="{{ site.github }}">Organization profile <span aria-hidden="true">↗</span></a>
          <a href="{{ site.basePath }}/projects/">Project register</a>
          <a href="{{ site.basePath }}/about/">About the organization</a>
        </div>
        <p class="footer-note">Each project keeps its own purpose, authority, and availability boundary.</p>
      </div>
    </footer>
  </body>
</html>
