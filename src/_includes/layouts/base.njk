<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="color-scheme" content="light">
    <title>{{ title }} | {{ site.name }}</title>
    <meta name="description" content="{{ description or site.description }}">
    <link rel="canonical" href="{{ site.url }}{{ page.url }}">
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="{{ site.name }}">
    <meta property="og:title" content="{{ title }} | {{ site.name }}">
    <meta property="og:description" content="{{ description or site.description }}">
    <meta property="og:url" content="{{ site.url }}{{ page.url }}">
    <meta property="og:image" content="{{ site.url }}{{ site.socialImage }}">
    <meta name="twitter:card" content="summary_large_image">
    <link rel="icon" href="/assets/favicon.svg" type="image/svg+xml">
    <link rel="stylesheet" href="/assets/site.css">
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="header-inner">
        <a class="wordmark" href="/" aria-label="ForgeWire Labs home">
          <span class="wordmark-mark" aria-hidden="true"><span>F</span><span>/</span><span>W</span></span>
          <span class="wordmark-name">ForgeWire <span>Labs</span></span>
        </a>
        <nav aria-label="Main navigation">
          <ul class="nav-list">
            <li><a href="/projects/"{% if page.url.startsWith('/projects') %} aria-current="page"{% endif %}>Projects</a></li>
            <li><a href="/engineering/"{% if page.url.startsWith('/engineering') %} aria-current="page"{% endif %}>Engineering</a></li>
            <li><a href="/about/"{% if page.url.startsWith('/about') %} aria-current="page"{% endif %}>About</a></li>
          </ul>
        </nav>
      </div>
    </header>
    <main id="main" tabindex="-1">
      {{ content | safe }}
    </main>
    <footer class="site-footer">
      <div class="footer-inner">
        <p class="footer-brand">ForgeWire Labs <span>·</span> Independent engineering and applied AI</p>
        <div class="footer-links">
          <a href="{{ site.github }}">GitHub organization</a>
          <a href="/projects/">Project availability</a>
        </div>
        <p class="footer-note">Each project has its own scope, repository, and release status.</p>
      </div>
    </footer>
  </body>
</html>
