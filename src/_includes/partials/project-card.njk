<article class="project-card project-card--{{ project.statusKind }}">
  <div class="project-card-head">
    <p class="project-group">{{ project.group }}</p>
    <p class="status status--{{ project.statusKind }}">{{ project.status }}</p>
  </div>
  <h3>{% if project.url %}<a href="{{ project.url }}">{{ project.name }}<span class="visually-hidden"> (project page)</span></a>{% else %}{{ project.name }}{% endif %}</h3>
  <p class="project-summary">{{ project.summary }}</p>
  <p class="maturity"><strong>Availability:</strong> {{ project.maturity }}</p>
  {% if project.url or project.secondaryUrl %}
    <div class="project-links">
      {% if project.url %}<a href="{{ project.url }}">{{ project.action }} <span aria-hidden="true">↗</span></a>{% endif %}
      {% if project.secondaryUrl %}<a href="{{ project.secondaryUrl }}">{{ project.secondaryAction }} <span aria-hidden="true">↗</span></a>{% endif %}
    </div>
  {% endif %}
</article>
